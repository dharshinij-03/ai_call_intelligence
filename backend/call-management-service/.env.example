# Neon Postgres connection string (Dashboard -> Connection Details -> pooled connection)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Path to a GCP service account JSON key with roles:
#   - Cloud Speech Client (roles/speech.client... or a custom role with speech.* )
#   - Cloud Translation API User
#   - Storage Object Admin (on the bucket below)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# GCS bucket used to stage uploaded call audio for long-running transcription.
# Required for the /calls/upload flow (Google's sync Speech API is capped at ~1 min / 10MB).
GCS_BUCKET_NAME=your-gcs-bucket-name

# Default + fallback language hints for Speech-to-Text (BCP-47 codes)
DEFAULT_LANGUAGE_CODE=hi-IN
ALTERNATIVE_LANGUAGE_CODES=["ta-IN","te-IN","bn-IN"]

UPLOAD_DIR=./storage/uploads
CORS_ORIGINS=["*"]
