DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Random secret used to sign JWTs — generate your own, don't reuse this example.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Required in the request body of POST /auth/register whenever the requested
# role isn't "citizen" — keeps the public registration endpoint from letting
# anyone self-elevate to operator/officer/admin. Share it only with whoever
# is provisioning staff accounts; rotate it if it leaks.
ADMIN_BOOTSTRAP_KEY=change-me

# Shared secret for machine-to-machine calls from other backend services
# (e.g. complaint-assignment-service looking up available officers).
SERVICE_API_KEY=change-me
