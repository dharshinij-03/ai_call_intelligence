DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

CALL_ANALYSIS_SERVICE_URL=http://localhost:8002
USER_MANAGEMENT_SERVICE_URL=http://localhost:8003
# Must match user-management-service's SERVICE_API_KEY
SERVICE_API_KEY=change-me

# Same Gemini setup as call-analysis-service: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
