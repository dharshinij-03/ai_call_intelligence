# Same Neon Postgres instance as call-management-service (separate table, no cross-service FK)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Google AI Studio key: https://aistudio.google.com/apikey (free tier, no card required)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Base URL of call-management-service, used to fetch a call's transcript
CALL_MANAGEMENT_SERVICE_URL=http://localhost:8001
