DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Must match user-management-service's JWT_SECRET_KEY/JWT_ALGORITHM exactly —
# this service verifies tokens locally (signature + expiry) rather than
# calling back into user-management-service on every request.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# Where citizens' browsers should stream audio for live transcription
# (used to build the URL shown to the demo page; not called server-side).
CALL_MANAGEMENT_SERVICE_URL=http://localhost:8001
